# Prisma Database URLs
# Gunakan parameter ?schema=cms untuk memastikan Prisma default ke schema cms
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&schema=cms"
DIRECT_URL="postgresql://user:password@host:5432/postgres?schema=cms"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Cloudinary
CLOUDINARY_URL="cloudinary://my_key:my_secret@my_cloud_name"
