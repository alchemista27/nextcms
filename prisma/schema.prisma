generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  schemas   = ["cms", "shared"]
}

enum Role {
  ADMIN
  CONTRIBUTOR
  SUBSCRIBER

  @@schema("cms")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  PENDING
  TRASH

  @@schema("cms")
}

enum MenuItemType {
  CUSTOM
  PAGE
  POST
  CATEGORY

  @@schema("cms")
}

model User {
  id        String   @id @db.Uuid
  role      Role     @default(SUBSCRIBER)
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sharedUser SharedUser @relation(fields: [id], references: [id])
  posts      Post[]
  media      Media[]
  revisions  Revision[]

  @@map("users")
  @@schema("cms")
}

model SharedUser {
  id            String    @id @db.Uuid
  email         String    @unique @db.VarChar
  full_name     String?   @db.VarChar
  phone         String?   @db.VarChar
  password_hash String?   @db.VarChar
  is_active     Boolean?
  created_at    DateTime? @db.Timestamptz
  updated_at    DateTime? @db.Timestamptz

  cmsUser       User?

  @@map("users")
  @@schema("shared")
}



model Post {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  content         String?    @db.Text
  excerpt         String?    @db.Text
  status          PostStatus @default(DRAFT)
  featuredImage   String?
  metaTitle       String?
  metaDescription String?    @db.Text
  ogImage         String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  authorId   String     @db.Uuid
  author     User       @relation(fields: [authorId], references: [id])
  categories Category[] @relation("PostCategories")
  tags       Tag[]      @relation("PostTags")

  @@index([slug])
  @@index([status])
  @@index([authorId])
  @@index([publishedAt])
  @@map("posts")
  @@schema("cms")
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  position  String
  bio       String?  @db.Text
  photoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
  @@schema("cms")
}

model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  url         String
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("gallery_images")
  @@schema("cms")
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String
  content     String   @db.Text
  avatarUrl   String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
  @@schema("cms")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  posts    Post[]     @relation("PostCategories")

  @@index([slug])
  @@index([parentId])
  @@map("categories")
  @@schema("cms")
}

model Tag {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[] @relation("PostTags")

  @@index([slug])
  @@map("tags")
  @@schema("cms")
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  alt          String?
  caption      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedById String @db.Uuid
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  @@index([mimeType])
  @@index([uploadedById])
  @@map("media")
  @@schema("cms")
}

model Menu {
  id        String   @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]

  @@map("menus")
  @@schema("cms")
}

model MenuItem {
  id          String       @id @default(cuid())
  label       String
  url         String?
  target      String       @default("_self")
  type        MenuItemType @default(CUSTOM)
  referenceId String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  menuId   String
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId String?
  parent   MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuItemHierarchy")

  @@index([menuId])
  @@index([parentId])
  @@map("menu_items")
  @@schema("cms")
}

model Revision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  title      String
  content    String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id])

  @@index([entityType, entityId])
  @@index([authorId])
  @@map("revisions")
  @@schema("cms")
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
  @@schema("cms")
}

model Appearance {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("appearance")
  @@schema("cms")
}
